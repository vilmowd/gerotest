---
import { categoryPath, categorySlug, getCategoriesWithContent } from '../lib/games';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  show?: boolean;
}

const { show = true } = Astro.props;
const categories = getCategoriesWithContent();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeSlug = path.startsWith('/category/') ? path.split('/')[2] || '' : '';
const homeActive = path === '/';
---

{
  show && (
    <>
      <div
        id="category-backdrop"
        class="fixed inset-0 z-40 bg-arcade-bg/70 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
        hidden
        aria-hidden="true"
      />

      <aside
        id="category-sidebar"
        class="category-sidebar fixed inset-y-0 left-0 z-50 flex w-[min(18rem,90vw)] max-w-xs -translate-x-full flex-col bg-transparent transition-transform duration-300 ease-out lg:sticky lg:top-[5.75rem] lg:z-30 lg:h-auto lg:w-64 lg:max-w-none lg:translate-x-0 lg:self-start"
        data-open="false"
        aria-label="Game categories"
      >
        <div class="category-sidebar-solid border-r border-arcade-border bg-arcade-panel/95 backdrop-blur-md">
          <div class="flex items-center justify-between gap-2 border-b border-arcade-border px-4 py-3">
            <div>
              <p class="font-display text-sm font-bold tracking-wide text-white">Categories</p>
            </div>
            <button
              type="button"
              id="category-close"
              class="btn px-2 py-1.5 lg:hidden"
              aria-label="Close categories"
            >
              ✕
            </button>
            <button
              type="button"
              id="category-collapse"
              class="btn hidden px-2 py-1.5 lg:inline-flex"
              aria-label="Collapse category menu"
              title="Collapse"
            >
              «
            </button>
          </div>

          <nav id="category-filters" class="overflow-visible px-2 py-3" aria-label="Filter by category">
            <button
              type="button"
              id="surprise-game"
              class="surprise-btn mb-2 w-full"
              title="Play a random game"
            >
              <span class="surprise-btn-inner">Surprise me</span>
            </button>

            <a
              href="/"
              class:list={['category-nav-item no-underline', homeActive && 'is-active']}
              aria-current={homeActive ? 'page' : undefined}
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="category-icon-wrap">
                  <CategoryIcon name="All" class="h-8 w-8" />
                </span>
                <span class="truncate">All Games</span>
              </span>
            </a>

            {categories.map((cat) => {
              const slug = categorySlug(cat.name);
              const on = slug === activeSlug;
              return (
                <a
                  href={categoryPath(cat.name)}
                  class:list={['category-nav-item no-underline', on && 'is-active']}
                  aria-current={on ? 'page' : undefined}
                >
                  <span class="flex min-w-0 items-center gap-3">
                    <span class="category-icon-wrap">
                      <CategoryIcon name={cat.name} class="h-8 w-8" />
                    </span>
                    <span class="truncate">{cat.name}</span>
                  </span>
                </a>
              );
            })}
          </nav>
        </div>

        <div class="category-sidebar-fade" aria-hidden="true"></div>
      </aside>
    </>
  )
}
