---
import { siteConfig } from '../data/site';

interface Props {
  showSearch?: boolean;
}

const { showSearch = true } = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b border-arcade-border backdrop-blur-md"
  style="padding-top: env(safe-area-inset-top); background-color: rgba(28, 39, 64, 0.96);"
>
  <div class="container-arcade flex flex-wrap items-center gap-2 py-2.5 sm:gap-3 sm:py-3">
    {
      showSearch && (
        <button
          type="button"
          id="category-toggle"
          class="btn min-h-11 min-w-11 shrink-0 border-arcade-border px-2.5"
          aria-expanded="false"
          aria-controls="category-sidebar"
          aria-label="Toggle categories menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h10"></path>
          </svg>
        </button>
      )
    }

    <a href="/" class="group flex min-w-0 shrink items-center gap-2 sm:gap-2.5" aria-label={`${siteConfig.name} home`}>
      <img
        src="/logo-icon.png"
        alt=""
        width="96"
        height="72"
        class="logo-alive h-9 w-auto bg-transparent sm:h-11 md:h-12"
      />
      <span class="font-display text-lg font-bold tracking-wide text-white transition group-hover:text-fuchsia-300 sm:text-xl md:text-2xl">
        <span class="bg-gradient-to-b from-white to-slate-300 bg-clip-text text-transparent">Gero</span><span class="bg-gradient-to-b from-amber-200 to-amber-500 bg-clip-text text-transparent">forge</span>
      </span>
    </a>

    {
      showSearch && (
        <div class="relative order-3 w-full min-w-0 flex-1 basis-full sm:order-none sm:basis-auto">
          <label for="game-search" class="sr-only">
            Search games
          </label>
          <input
            id="game-search"
            type="search"
            placeholder="Search games…"
            autocomplete="off"
            enterkeyhint="search"
            class="min-h-11 w-full rounded-xl border border-arcade-border bg-arcade-panel py-2.5 pl-10 pr-3 text-base text-white placeholder:text-arcade-muted outline-none transition focus:border-arcade-muted/50 focus:ring-2 focus:ring-arcade-accent/20 sm:text-sm"
          />
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-arcade-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </div>
      )
    }

  </div>
</header>
