---
import { getAdSenseClient, isAdSenseConfigured } from '../lib/adsense';
import { getGoogleAnalyticsId, isGoogleAnalyticsConfigured } from '../lib/analytics';

const adsenseOn = isAdSenseConfigured();
const gaOn = isGoogleAnalyticsConfigured();
const client = getAdSenseClient();
const gaId = getGoogleAnalyticsId();
---

<div
  id="gf-choice"
  class="gf-choice"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gf-choice-title"
  aria-describedby="gf-choice-desc"
  hidden
>
  <div class="gf-choice-card" data-gf-card>
    <p id="gf-choice-title" class="font-display text-base font-bold text-white sm:text-lg">
      We use cookies
    </p>
    <p id="gf-choice-desc" class="mt-2 text-xs leading-relaxed text-arcade-muted sm:text-sm">
      We use essential cookies for the site to work. A Google tag is on every page; analytics and ad cookies stay off until you accept.
      Details in our <a class="text-arcade-accent underline" href="/privacy-policy/">Privacy Policy</a>.
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" class="btn btn-accent text-xs sm:text-sm" data-gf-accept>
        Accept all
      </button>
      <button type="button" class="btn text-xs sm:text-sm" data-gf-essential>
        Essential only
      </button>
    </div>
  </div>
</div>

<div id="gf-block-note" class="gf-block-note" hidden role="status">
  <p class="text-sm text-white">
    An ad blocker is hiding the cookie choice, so the page was left open. Pause the blocker and refresh if you want to allow ads.
  </p>
  <button type="button" class="btn mt-3 text-xs sm:text-sm" data-gf-note-close>
    Continue
  </button>
</div>

<script
  define:vars={{
    adsenseClient: client,
    gaMeasurementId: gaId,
    adsenseConfigured: adsenseOn,
    gaConfigured: gaOn,
  }}
>
  const KEY = 'gf-cookie-consent';
  const KEY_TS = 'gf-cookie-consent-ts';

  function readConsent() {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'accepted' || v === 'essential') return v;
    } catch (e) {}
    return null;
  }

  function writeConsent(value) {
    try {
      localStorage.setItem(KEY, value);
      localStorage.setItem(KEY_TS, String(Date.now()));
    } catch (e) {}
  }

  function ensureGtag() {
    window.dataLayer = window.dataLayer || [];
    if (typeof window.gtag !== 'function') {
      window.gtag = function gtag() {
        window.dataLayer.push(arguments);
      };
    }
  }

  function updateConsentMode(accepted) {
    ensureGtag();
    window.gtag('consent', 'update', {
      ad_storage: accepted ? 'granted' : 'denied',
      ad_user_data: accepted ? 'granted' : 'denied',
      ad_personalization: accepted ? 'granted' : 'denied',
      analytics_storage: accepted ? 'granted' : 'denied',
    });
    try {
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.requestNonPersonalizedAds = accepted ? 0 : 1;
    } catch (e) {}
    document.documentElement.dataset.adsConsent = accepted ? 'accepted' : 'essential';
  }

  function loadScript(src, attrs) {
    if (document.querySelector('script[src="' + src + '"]')) return;
    const s = document.createElement('script');
    s.src = src;
    s.async = true;
    if (attrs) {
      Object.keys(attrs).forEach(function (k) {
        s.setAttribute(k, attrs[k]);
      });
    }
    document.head.appendChild(s);
  }

  function revealAdUnits() {
    document.querySelectorAll('[data-ad-unit]').forEach(function (el) {
      el.hidden = false;
      try {
        window.adsbygoogle = window.adsbygoogle || [];
        window.adsbygoogle.push({});
      } catch (e) {}
    });
  }

  function hideAdUnits() {
    document.querySelectorAll('[data-ad-unit]').forEach(function (el) {
      el.hidden = true;
    });
  }

  function loadTracking(accepted) {
    updateConsentMode(accepted);

    if (!accepted) {
      hideAdUnits();
      return;
    }

    if (gaConfigured && gaMeasurementId) {
      loadScript('https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaMeasurementId));
      ensureGtag();
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId, {
        anonymize_ip: true,
        allow_google_signals: true,
      });
    }

    if (adsenseConfigured && adsenseClient) {
      loadScript(
        'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' +
          encodeURIComponent(adsenseClient),
        { crossorigin: 'anonymous' },
      );
      window.setTimeout(revealAdUnits, 400);
    }
  }

  function setBackgroundInert(on) {
    Array.from(document.body.children).forEach(function (el) {
      if (el.id === 'gf-choice' || el.id === 'gf-block-note') return;
      el.inert = on;
    });
  }

  function closeChoice(banner) {
    banner.hidden = true;
    document.body.classList.remove('gf-choice-open');
    setBackgroundInert(false);
  }

  function showNote() {
    const note = document.getElementById('gf-block-note');
    if (note) note.hidden = false;
  }

  function choiceBlocked(banner, checkSize) {
    if (banner.hidden) return false;
    const bannerStyle = getComputedStyle(banner);
    if (bannerStyle.display === 'none' || bannerStyle.visibility === 'hidden') return true;
    const card = banner.querySelector('[data-gf-card]');
    if (!card || !card.isConnected) return true;
    const style = getComputedStyle(card);
    if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) {
      return true;
    }
    if (!checkSize) return false;
    const rect = card.getBoundingClientRect();
    return rect.width <= 8 || rect.height <= 8;
  }

  function releaseIfBlocked(banner, checkSize) {
    if (!choiceBlocked(banner, checkSize)) return;
    closeChoice(banner);
    if (!readConsent()) {
      writeConsent('essential');
      loadTracking(false);
    }
    showNote();
  }

  function watchChoice(banner) {
    window.setTimeout(function () {
      releaseIfBlocked(banner, false);
    }, 50);
    window.setTimeout(function () {
      releaseIfBlocked(banner, true);
    }, 400);
    window.setTimeout(function () {
      releaseIfBlocked(banner, true);
    }, 1200);
  }

  function bindBanner(banner) {
    if (banner.dataset.bound === '1') return;
    banner.dataset.bound = '1';
    banner.querySelector('[data-gf-accept]')?.addEventListener('click', function () {
      writeConsent('accepted');
      loadTracking(true);
      closeChoice(banner);
    });
    banner.querySelector('[data-gf-essential]')?.addEventListener('click', function () {
      writeConsent('essential');
      loadTracking(false);
      closeChoice(banner);
    });
  }

  function openChoice(banner) {
    const note = document.getElementById('gf-block-note');
    if (note) note.hidden = true;
    banner.hidden = false;
    document.body.classList.add('gf-choice-open');
    setBackgroundInert(true);
    banner.querySelector('[data-gf-accept]')?.focus();
    watchChoice(banner);
  }

  function initConsent() {
    const banner = document.getElementById('gf-choice');
    if (!banner) return;
    bindBanner(banner);

    const existing = readConsent();
    if (existing === 'accepted') {
      closeChoice(banner);
      loadTracking(true);
      return;
    }
    if (existing === 'essential') {
      closeChoice(banner);
      loadTracking(false);
      return;
    }

    updateConsentMode(false);
    openChoice(banner);
  }

  document.getElementById('gf-choice-reopen')?.addEventListener('click', function (e) {
    e.preventDefault();
    try {
      localStorage.removeItem(KEY);
      localStorage.removeItem(KEY_TS);
    } catch (err) {}
    const banner = document.getElementById('gf-choice');
    if (banner) openChoice(banner);
  });

  document.querySelector('[data-gf-note-close]')?.addEventListener('click', function () {
    const note = document.getElementById('gf-block-note');
    if (note) note.hidden = true;
  });

  initConsent();
  document.addEventListener('astro:page-load', initConsent);
</script>
