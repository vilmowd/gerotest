---
import type { Game } from '../lib/games';
import { isSafeImageUrl } from '../lib/security';

interface Props {
  game: Game;
  filterable?: boolean;
}

const { game, filterable = true } = Astro.props;
const thumb = isSafeImageUrl(game.thumb) ? game.thumb : '/og-default.jpg';
---

<article
  class="game-card group reveal"
  role="listitem"
  {...(filterable
    ? {
        'data-game-card': true,
        'data-title': game.title,
        'data-category': game.category,
        'data-tags': game.tags.join(' '),
      }
    : {})}
>
  <a href={`/game/${game.slug}/`} class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-arcade-accent">
    <div class="media-skel is-loading relative aspect-[4/3] overflow-hidden bg-arcade-panel">
      <img
        src={thumb}
        alt={`${game.title} thumbnail`}
        loading="lazy"
        decoding="async"
        width={game.width || 600}
        height={game.height || 400}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        data-skel-img
        referrerpolicy="no-referrer"
      />
      <div
        class="absolute inset-0 z-[3] flex items-center justify-center bg-arcade-bg/60 opacity-0 transition group-hover:opacity-100"
        aria-hidden="true"
      >
        <span class="rounded-full bg-arcade-accent px-4 py-2 font-display text-sm font-bold text-arcade-bg shadow-glow">
          Play
        </span>
      </div>
      <span class="absolute left-2 top-2 z-[3] rounded-md bg-arcade-bg/80 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-arcade-accent backdrop-blur">
        {game.category}
      </span>
    </div>
    <div class="p-3">
      <h3 class="line-clamp-1 font-semibold text-white group-hover:text-arcade-accent">
        {game.title}
      </h3>
      <p class="mt-1 line-clamp-2 text-xs text-arcade-muted">{game.description}</p>
    </div>
  </a>
</article>
