---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-8 w-8' } = Astro.props;
const key = name.trim().toLowerCase();
const isAll = key === 'all' || key === 'all games';
---

{
  isAll ? (
    <img
      src="/logo-icon.png"
      alt=""
      width="32"
      height="32"
      class:list={['category-icon', 'category-icon-logo', className]}
      aria-hidden="true"
      decoding="async"
    />
  ) : (
    <svg
      class:list={['category-icon', className]}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      {
        key === 'action' ? (
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        ) : key === 'adventure' ? (
          <>
            <circle cx="12" cy="12" r="10" />
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88" />
          </>
        ) : key === 'arcade' ? (
          <>
            <line x1="12" y1="2" x2="12" y2="9" />
            <circle cx="12" cy="2" r="1.5" fill="currentColor" stroke="none" />
            <rect x="3" y="9" width="18" height="12" rx="3" />
            <circle cx="8" cy="15" r="1.5" />
            <line x1="14" y1="13" x2="18" y2="13" />
            <line x1="14" y1="17" x2="16" y2="17" />
          </>
        ) : key === 'racing' ? (
          <>
            <path d="M5 17h14" />
            <path d="M6 17 8 9h8l2 8" />
            <circle cx="8" cy="17" r="2" />
            <circle cx="16" cy="17" r="2" />
            <path d="M9 12h6" />
          </>
        ) : key === 'puzzle' ? (
          <>
            <path d="M10 3h4v2a2 2 0 1 0 0 4v2h-4V3z" />
            <path d="M14 3h3a2 2 0 0 1 2 2v3h-2a2 2 0 1 0 0 4h2v3a2 2 0 0 1-2 2h-3v-2a2 2 0 1 0-4 0v2H8a2 2 0 0 1-2-2v-3h2a2 2 0 1 0 0-4H6V5a2 2 0 0 1 2-2h2" />
          </>
        ) : key === 'shooting' ? (
          <>
            <circle cx="12" cy="12" r="10" />
            <circle cx="12" cy="12" r="3" />
            <line x1="12" y1="2" x2="12" y2="5" />
            <line x1="12" y1="19" x2="12" y2="22" />
            <line x1="2" y1="12" x2="5" y2="12" />
            <line x1="19" y1="12" x2="22" y2="12" />
          </>
        ) : key === 'sports' ? (
          <>
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </>
        ) : key === 'multiplayer' ? (
          <>
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </>
        ) : key === 'clicker' ? (
          <path d="M4 4l7.07 17 2.51-7.39L21 11.07 4 4z" />
        ) : key === 'hypercasual' ? (
          <>
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </>
        ) : key === '3d' ? (
          <>
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
            <path d="m3.3 7 8.7 5 8.7-5" />
            <path d="M12 22V12" />
          </>
        ) : key === 'girls' ? (
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        ) : key === 'boys' ? (
          <>
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="m9 12 2 2 4-4" />
          </>
        ) : key === 'stickman' ? (
          <>
            <circle cx="12" cy="5" r="2" />
            <path d="M12 7v8" />
            <path d="M7 11h10" />
            <path d="m9 21 3-6 3 6" />
          </>
        ) : key === 'strategy' ? (
          <>
            <rect x="8" y="3" width="2" height="3" />
            <rect x="11" y="3" width="2" height="3" />
            <rect x="14" y="3" width="2" height="3" />
            <rect x="7" y="6" width="10" height="3" />
            <rect x="6" y="9" width="12" height="9" />
            <line x1="4" y1="21" x2="20" y2="21" />
          </>
        ) : key === 'cooking' ? (
          <>
            <line x1="8" y1="6" x2="8" y2="3" />
            <line x1="12" y1="6" x2="12" y2="2" />
            <line x1="16" y1="6" x2="16" y2="3" />
            <line x1="3" y1="10" x2="21" y2="10" />
            <path d="M5 10v8a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-8" />
          </>
        ) : key === 'io' ? (
          <>
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            <circle cx="12" cy="12" r="3" />
          </>
        ) : key === 'fighting' ? (
          <>
            <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5" />
            <line x1="13" y1="19" x2="19" y2="13" />
            <line x1="16" y1="16" x2="20" y2="20" />
            <line x1="19" y1="21" x2="21" y2="19" />
            <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5" />
            <line x1="5" y1="14" x2="9" y2="18" />
            <line x1="7" y1="17" x2="4" y2="20" />
            <line x1="3" y1="19" x2="5" y2="21" />
          </>
        ) : key === 'simulation' ? (
          <>
            <line x1="4" y1="21" x2="4" y2="14" />
            <line x1="4" y1="10" x2="4" y2="3" />
            <line x1="12" y1="21" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12" y2="3" />
            <line x1="20" y1="21" x2="20" y2="16" />
            <line x1="20" y1="12" x2="20" y2="3" />
            <line x1="2" y1="14" x2="6" y2="14" />
            <line x1="10" y1="8" x2="14" y2="8" />
            <line x1="18" y1="16" x2="22" y2="16" />
          </>
        ) : key === 'educational' ? (
          <>
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </>
        ) : key === 'ports' ? (
          <>
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <line x1="8" y1="21" x2="16" y2="21" />
            <line x1="12" y1="17" x2="12" y2="21" />
          </>
        ) : (
          <>
            <circle cx="12" cy="12" r="10" />
            <polygon points="10 8 16 12 10 16 10 8" />
          </>
        )
      }
    </svg>
  )
}
