---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import GameBanner from '../components/GameBanner.astro';
import {
  allGames,
  getPopularGames,
  getPopularInCategory,
  getTopCategories,
  getTrendingGames,
} from '../lib/games';
import { siteConfig } from '../data/site';
import AdUnit from '../components/AdUnit.astro';

/** Full rows under each banner (divisible by 2/4/6/8) */
const ROW = 24;

const trending = getTrendingGames(1)[0] ?? allGames[0];
const heroBanners = getPopularGames(3, 0);
const heroCards = getPopularGames(ROW, 55);
const popularBanners = getPopularGames(2, 3);
const popularCards = getPopularGames(ROW, 5);
const featuredPool = getTrendingGames(ROW + 1);
const featuredBanner = featuredPool[0] ?? null;
const featuredCards = featuredPool.slice(1, ROW + 1);
const topCategories = getTopCategories(6);
const categoryRows = topCategories
  .map((cat) => ({
    ...cat,
    games: getPopularInCategory(cat.name, ROW + 1),
  }))
  .filter((row) => row.games.length >= ROW + 1);
const morePopular = getPopularGames(4, 29);
const morePopularCards = getPopularGames(ROW, 37);
const games = allGames;
/** Catalog loads when scrolled into view: 80 first, then +40 via Load more */
const CATALOG_INITIAL = 80;
const CATALOG_STEP = 40;

const dayIndex = Math.floor(Date.now() / 86_400_000);
const dailyPick = allGames.length
  ? allGames[dayIndex % allGames.length]
  : null;
const dailyCards = getPopularGames(ROW + 1, (dayIndex % 40) + 8)
  .filter((g) => g.slug !== dailyPick?.slug)
  .slice(0, ROW);

const kidQuickCats = ['Arcade', 'Puzzle', 'Hypercasual', 'Stickman', 'Racing', 'Sports']
  .filter((name) => allGames.some((g) => g.category === name))
  .slice(0, 5);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.url}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="container-arcade pt-6" data-home-browse>
    {
      trending && (
        <div class="reveal relative overflow-hidden rounded-2xl border border-arcade-border bg-arcade-card" data-reveal-delay="0">
          <div
            class="absolute inset-0 z-10"
            style="background: linear-gradient(90deg, #141b2d 0%, rgba(20,27,45,0.94) 26%, rgba(20,27,45,0.5) 52%, rgba(20,27,45,0.1) 74%, transparent 100%);"
          />
          <div class="media-skel is-loading absolute inset-0">
            <img
              src={trending.thumb || '/og-default.jpg'}
              alt=""
              class="absolute inset-0 h-full w-full object-cover brightness-105 saturate-125"
              loading="eager"
              decoding="async"
              aria-hidden="true"
              data-skel-img
            />
          </div>
          <div class="relative z-20 grid gap-5 p-4 sm:gap-6 sm:p-8 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:p-10">
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-arcade-accent">
                Trending Now
              </p>
              <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
                {trending.title}
              </h1>
              <p class="mt-3 max-w-xl text-sm text-white/90 sm:text-base">
                {trending.description}
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={`/game/${trending.slug}/`} class="btn btn-accent">
                  Play Now
                </a>
                <span class="btn pointer-events-none opacity-80">{trending.category}</span>
              </div>
            </div>
            <div class="media-skel is-loading hidden lg:block">
              <img
                src={trending.thumb || '/og-default.jpg'}
                alt={`${trending.title} cover`}
                class="mx-auto max-h-64 w-auto rounded-xl border border-arcade-border shadow-glow"
                width={trending.width}
                height={trending.height}
                loading="eager"
                data-skel-img
              />
            </div>
          </div>
        </div>
      )
    }

    {
      heroBanners.length > 0 && (
        <div class="mt-6">
          <div class="grid gap-3 md:grid-cols-3">
            {heroBanners.map((game) => (
              <GameBanner game={game} size="md" />
            ))}
          </div>
          {
            heroCards.length > 0 && (
              <div class="games-row-grid mt-3">
                {heroCards.map((game) => (
                  <GameCard game={game} filterable={false} compact />
                ))}
              </div>
            )
          }
        </div>
      )
    }

    {
      kidQuickCats.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2" aria-label="Quick category jumps">
          {kidQuickCats.map((name) => (
            <a
              href={`/?category=${encodeURIComponent(name)}`}
              class="quick-cat-chip"
            >
              {name}
            </a>
          ))}
          <a href="/#catalog-section" class="quick-cat-chip quick-cat-chip--muted">
            Browse all
          </a>
        </div>
      )
    }
  </section>

  <section
    id="continue-playing-section"
    class="container-arcade mt-10"
    aria-labelledby="continue-heading"
    hidden
  >
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="continue-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
          Continue playing
        </h2>
        <p class="text-sm text-arcade-muted">Jump back into games you already opened</p>
      </div>
    </div>
    <div id="continue-playing-grid" class="games-row-grid"></div>
  </section>

  <section
    id="favorites-section"
    class="container-arcade mt-10"
    aria-labelledby="favorites-heading"
    hidden
  >
    <div class="mb-4">
      <h2 id="favorites-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
        Saved favorites
      </h2>
      <p class="text-sm text-arcade-muted">Your hearted games, ready when you are</p>
    </div>
    <div id="favorites-grid" class="games-row-grid"></div>
  </section>

  {
    dailyPick && (
      <section class="container-arcade mt-10" data-home-browse aria-labelledby="daily-heading">
        <div class="mb-4">
          <h2 id="daily-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
            Game of the day
          </h2>
          <p class="text-sm text-arcade-muted">A fresh free pick every day — tap and play</p>
        </div>
        <GameBanner game={dailyPick} size="lg" />
        {
          dailyCards.length > 0 && (
            <div class="games-row-grid mt-3">
              {dailyCards.map((game) => (
                <GameCard game={game} filterable={false} compact />
              ))}
            </div>
          )
        }
      </section>
    )
  }

  {
    popularCards.length > 0 && (
      <section class="container-arcade mt-10" data-home-browse aria-labelledby="popular-heading">
        <div class="mb-4">
          <h2 id="popular-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
            Popular right now
          </h2>
          <p class="text-sm text-arcade-muted">Big banners for the games players jump into first</p>
        </div>
        {
          popularBanners.length > 0 && (
            <div class="grid gap-3 md:grid-cols-2">
              {popularBanners.map((game) => (
                <GameBanner game={game} size="lg" />
              ))}
            </div>
          )
        }
        <div class="games-row-grid mt-3">
          {popularCards.map((game) => (
            <GameCard game={game} filterable={false} compact />
          ))}
        </div>
      </section>
    )
  }

  {
    featuredBanner && featuredCards.length > 0 && (
      <section class="container-arcade mt-10" data-home-browse aria-labelledby="featured-heading">
        <div class="mb-4">
          <h2 id="featured-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
            Featured picks
          </h2>
          <p class="text-sm text-arcade-muted">Fresh drops packed with fun</p>
        </div>
        <div class="mb-3">
          <GameBanner game={featuredBanner} size="lg" />
        </div>
        <div class="games-row-grid">
          {featuredCards.map((game) => (
            <GameCard game={game} filterable={false} compact />
          ))}
        </div>
      </section>
    )
  }

  {
    categoryRows.map((row) => (
      <section class="container-arcade mt-10" data-home-browse aria-labelledby={`cat-${row.name}`}>
        <div class="mb-4 flex items-end justify-between gap-3">
          <div>
            <h2 id={`cat-${row.name}`} class="font-display text-xl font-bold text-white sm:text-2xl">
              Popular in {row.name}
            </h2>
          </div>
        </div>
        <div class="mb-3">
          <GameBanner game={row.games[0]} size="lg" />
        </div>
        <div class="games-row-grid">
          {row.games.slice(1, ROW + 1).map((game) => (
            <GameCard game={game} filterable={false} compact />
          ))}
        </div>
      </section>
    ))
  }

  {
    morePopular.length > 0 && (
      <section class="container-arcade mt-10" data-home-browse aria-labelledby="more-popular-heading">
        <div class="mb-4">
          <h2 id="more-popular-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
            More games you’ll love
          </h2>
          <p class="text-sm text-arcade-muted">Keep exploring — something new every scroll</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {morePopular.map((game) => (
            <GameBanner game={game} size="md" />
          ))}
        </div>
        {
          morePopularCards.length > 0 && (
            <div class="games-row-grid mt-3">
              {morePopularCards.map((game) => (
                <GameCard game={game} filterable={false} compact />
              ))}
            </div>
          )
        }
      </section>
    )
  }

  <div class="container-arcade mt-10" data-home-browse>
    <AdUnit adSlot={siteConfig.adsenseSlots.homeInFeed} format="horizontal" />
  </div>

  <section
    id="catalog-section"
    class="container-arcade mt-12 scroll-mt-24 pb-8"
    aria-labelledby="catalog-heading"
  >
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="catalog-heading" class="font-display text-xl font-bold text-white sm:text-2xl">
          All games
        </h2>
        <p class="text-sm text-arcade-muted">
          <span id="active-category-label">All games</span>
          {' · '}
          {games.length} free HTML5 titles — use search or the category menu
          <span id="filter-result-count" class="ml-1 text-arcade-accent" aria-hidden="true"></span>
        </p>
        <p id="filter-live" class="sr-only" aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>

    <div
      id="games-grid"
      class="games-row-grid"
      role="list"
      data-catalog-grid
      data-catalog-initial={CATALOG_INITIAL}
      data-catalog-step={CATALOG_STEP}
      data-catalog-total={games.length}
    ></div>

    <p id="catalog-placeholder" class="py-10 text-center text-sm text-arcade-muted">
      Scroll here to load the full catalog…
    </p>

    <div class="mt-6 flex flex-col items-center gap-2">
      <button
        type="button"
        id="catalog-load-more"
        class="btn btn-accent min-h-11 px-6"
        hidden
      >
        Load more games
      </button>
      <p id="catalog-page-status" class="text-xs text-arcade-muted" aria-live="polite">
        {games.length} games available
      </p>
    </div>

    <p id="games-empty" class="is-filtered-out py-16 text-center text-arcade-muted">
      No games match your search. Try another keyword or category.
    </p>
  </section>
</BaseLayout>
