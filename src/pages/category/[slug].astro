---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import {
  categoryPath,
  categorySlug,
  getCategoriesWithContent,
  getGamesByCategory,
  type CategoryCount,
} from '../../lib/games';
import { siteConfig } from '../../data/site';

export function getStaticPaths() {
  return getCategoriesWithContent().map((category) => ({
    params: { slug: categorySlug(category.name) },
    props: { category },
  }));
}

interface Props {
  category: CategoryCount;
}

const { category } = Astro.props;
const games = getGamesByCategory(category.name);
const others = getCategoriesWithContent().filter((item) => item.name !== category.name);
const pagePath = categoryPath(category.name);
const intro = `Play ${games.length} free ${category.name} games in your browser on ${siteConfig.name}. No download — open a title and play instantly.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} Games`,
  description: intro,
  url: new URL(pagePath, Astro.site).href,
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: games.length,
    itemListElement: games.slice(0, 24).map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: game.title,
      url: new URL(`/game/${game.slug}/`, Astro.site).href,
    })),
  },
};
---

<BaseLayout
  title={`${category.name} Games`}
  description={intro}
  canonical={pagePath}
  jsonLd={jsonLd}
>
  <div class="container-arcade py-6 sm:py-8">
    <nav class="mb-4 text-xs text-arcade-muted sm:text-sm" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-arcade-accent">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-white">{category.name}</li>
      </ol>
    </nav>

    <h1 class="font-display text-3xl font-bold text-white sm:text-4xl">
      {category.name} games
    </h1>

    <div class="games-row-grid mt-6">
      {
        games.map((game) => (
          <GameCard game={game} filterable={false} compact />
        ))
      }
    </div>

    {
      others.length > 0 && (
        <section class="mt-12" aria-labelledby="more-categories-heading">
          <h2 id="more-categories-heading" class="font-display text-xl font-bold text-white">
            More categories
          </h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              others.map((item) => (
                <a href={categoryPath(item.name)} class="quick-cat-chip">
                  {item.name}
                </a>
              ))
            }
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
